          "hint": "是否发出该通知。"
        },
        "auto_open_bazaar.label": "自动打开 Bazaar",
        "emit_chat_message.label": "发送聊天消息",
        "emit_client_sound.label": "播放客户端音效"
      }
    },

    "advanced.{}": {
      "category.label": "高级设置",
      "category.hint": "模组流程与功能的高级设置",
      "auto_update.{}": {
        "label": "自动更新",
        "hint": "在发现新版本时自动更新模组。"
      }
