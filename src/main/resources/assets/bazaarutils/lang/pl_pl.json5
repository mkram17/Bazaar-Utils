            },
            "threshold.{}": {
              "label": "Próg",
              "hint": "Wartość, powyżej której ograniczenie zostanie uruchomione."
            }
          },

          "name.{}": {
            "value.{}": {
              "label": "Nazwa przedmiotu",
              "hint": "Nazwa przedmiotu, która uruchomi ograniczenie, jeśli wystąpi w akcji sprzedaży."
